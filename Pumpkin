-- Dragging
local function makeDraggable(dragTarget, moveTarget, miniMode)
    local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
    local moved = false
    dragTarget.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragInput = true, input
            dragStart, startPos = input.Position, moveTarget.Position
            moved = false
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local d = input.Position - dragStart
            if d.Magnitude > 4 then moved = true end
            if moved then
                moveTarget.Position = UDim2.new(startPos.X.Scale,
                    startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input == dragInput then
            dragging, dragInput = false, nil
            if miniMode and not moved then
                widget.Visible = true
                miniDot.Visible = false
                widget.Position = moveTarget.Position
            end
        end
    end)
end
