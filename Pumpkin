    promptPatterns  = { "collect", "grab", "pick", "harvest", "take", "pumpkin" },

    settleTime      = 0.30,   -- after teleport, before fire
    postFireWait    = 0.55,   -- after fire, before verify
    delayBetween    = 0.4,    -- between pumpkins (retries handle their own wait)
    retryBackoffMax = 4.0,    -- cap the retry wait
    scanInterval    = 3,
    batchSize       = 500,
    groundOffset    = 3,      -- HRP sits this far above ground
    groundSearchTop = 60,     -- raycast start height above pumpkin
    groundSearchBot = 120,    -- raycast total downward distance
}

-- 12 teleport offsets — first is AT pumpkin, drift outward only on retries
local TELEPORT_OFFSETS = {
    Vector3.new(0, 0.5, 0),
    Vector3.new(0, 1.5, 0),
    Vector3.new(0.5, 1, 0),
    Vector3.new(-0.5, 1, 0),
    Vector3.new(0, 1, 0.5),
    Vector3.new(0, 1, -0.5),
    Vector3.new(0, 2, 0),
    Vector3.new(1, 1, 0),
    Vector3.new(-1, 1, 0),
    Vector3.new(0, 1, 1),
    Vector3.new(0, 1, -1),
    Vector3.new(0, 3, 0),
}

