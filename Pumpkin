local function w(t) return (task and task.wait or wait)(t) end
local function sp(fn, ...) return (task and task.spawn or coroutine.wrap)(fn, ...) end
local function connect(sig, fn)
    local c = sig:Connect(fn)
    table.insert(connections, c)
    return c
end
local function disconnectAll()
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    table.clear(connections)
end

-- ============================================================
-- HELPERS
-- ============================================================
local function pathOf(inst)
    local parts, cur = {}, inst
    while cur and cur ~= game do
        table.insert(parts, 1, cur.Name)
        cur = cur.Parent
        if #parts > 12 then break end
    end
    return table.concat(parts, " > ")
end
local function getPosition(inst)
    if not inst or not inst.Parent then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then
        local ok, cf = pcall(function() return inst:GetModelCFrame() end)
        if ok and cf then return cf.Position end
        if inst.PrimaryPart then return inst.PrimaryPart.Position end
    end
    return nil
end
local function isInCamera(inst)
    local cur = inst
    while cur and cur ~= game do
        if cur:IsA("Camera") then return true end
        cur = cur.Parent
    end
    return false
end
local function isInPlayerOrTool(inst)
    local cur = inst.Parent
    while cur and cur ~= workspace do
        if cur:IsA("Tool") or cur:IsA("Accessory") then return true end
        if cur:IsA("Model") and cur:FindFirstChildOfClass("Humanoid") then return true end
        cur = cur.Parent
    end
    return false
end
local function nameMatchesPumpkin(name)
    local lower = name:lower()
    for _, pat in ipairs(CONFIG.pumpkinPatterns) do
        if lower:find(pat, 1, true) then return pat end
    end
    return nil
end
local function ancestorPumpkinFolder(inst)
    local cur = inst.Parent
    local depth = 0
    while cur and cur ~= workspace and depth < 10 do
        local pat = nameMatchesPumpkin(cur.Name)
        if pat then return cur, pat end
        cur = cur.Parent
        depth = depth + 1
    end
    return nil, nil
end
local function findActivePrompt(inst)
    local function check(p)
        if not p or not p:IsA("ProximityPrompt") then return nil end
        if p.Enabled == false then return nil end
        local text = ((p.ActionText or "") .. " " .. (p.ObjectText or "")):lower()
        for _, pat in ipairs(CONFIG.promptPatterns) do
            if text:find(pat, 1, true) then return p end
        end
        return nil
    end
    local self = check(inst:FindFirstChildOfClass("ProximityPrompt"))
    if self then return self end
    for _, d in ipairs(inst:GetDescendants()) do
        local p = check(d)
        if p then return p end
    end
    return nil
end
local function findClickDetector(inst)
    local cd = inst:FindFirstChildOfClass("ClickDetector")
    if cd and cd.Enabled ~= false then return cd end
    if inst:IsA("Model") or inst:IsA("Folder") then
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("ClickDetector") and d.Enabled ~= false then return d end
        end
    end
    return nil
end

-- ============================================================
-- PUMPKIN BOUNDS (position + size for stand distance)
-- ============================================================
local function getPumpkinBounds(inst)
    if not inst or not inst.Parent then return nil, nil end
    if inst:IsA("BasePart") then
        return inst.Position, inst.Size
    elseif inst:IsA("Model") then
        local ok, cf, sz = pcall(function() return inst:GetBoundingBox() end)
        if ok and cf then return cf.Position, sz end
        return getPosition(inst), Vector3.new(2, 2, 2)
    end
    return getPosition(inst), Vector3.new(2, 2, 2)
end

-- ============================================================
-- SCANNER
-- ============================================================
local function processCandidate(inst)
    if not inst or not inst.Parent then return end
    if not inst:IsDescendantOf(workspace) then return end
    if isInCamera(inst) or isInPlayerOrTool(inst) then return end

    local instPat  = nameMatchesPumpkin(inst.Name)
    local folder   = ancestorPumpkinFolder(inst)
    local prompt   = findActivePrompt(inst)
    local hasClick = findClickDetector(inst) ~= nil
    local isActive = prompt ~= nil or hasClick

    if not isActive then return end
    if not (instPat or folder or nameMatchesPumpkin(
        (prompt and prompt.Parent and prompt.Parent.Name) or "")) then return end

    local logTarget = inst
    if prompt and prompt.Parent and prompt.Parent ~= inst then
        logTarget = prompt.Parent
    end

    if found[logTarget] then
        found[logTarget].isActive = isActive
        return
    end

    local cur = logTarget.Parent
    while cur and cur ~= workspace do
        if found[cur] then return end
        cur = cur.Parent
    end

    local pos = getPosition(logTarget)
    local record = {
        instance  = logTarget,
        path      = pathOf(logTarget),
        position  = pos,
        isActive  = isActive,
        hasPrompt = prompt ~= nil,
        hasClick  = hasClick,
    }
    found[logTarget] = record
    table.insert(foundOrder, record)
end

local function fullScan()
    if scanBusy or not running then return end
    scanBusy = true
    sp(function()
        local descendants
        local ok = pcall(function() descendants = workspace:GetDescendants() end)
        if not ok then scanBusy = false; return end
        for i = 1, #descendants do
            if not running then break end
            pcall(processCandidate, descendants[i])
            if i % CONFIG.batchSize == 0 then w() end
        end
        scanBusy = false
    end)
end

-- ============================================================
-- CHARACTER + GROUND HELPERS
-- ============================================================
local function getLocalCharacter()
    local char = Me.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return nil end
    if hum.Sit or hum.SeatPart or hum.PlatformStand then return nil end
    return char, hum, hrp
end

local function findGroundBelow(worldPos, character)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = true
    params.RespectCanCollide = true
    local start = worldPos + Vector3.new(0, 30, 0)
    local hit = workspace:Raycast(start, Vector3.new(0, -80, 0), params)
    if hit then return hit.Position end
    return nil
end

-- ============================================================
-- STAND DISTANCE / POSITION
-- ============================================================
local STAND_DIRECTIONS = {
    Vector3.new(1, 0, 0),
    Vector3.new(-1, 0, 0),
    Vector3.new(0, 0, 1),
    Vector3.new(0, 0, -1),
    Vector3.new(0.707, 0, 0.707),
    Vector3.new(-0.707, 0, 0.707),
    Vector3.new(0.707, 0, -0.707),
    Vector3.new(-0.707, 0, -0.707),
}

local function computeStandDistance(prompt, pumpkinSize)
    local maxAct = 10
    if prompt then
        pcall(function() maxAct = prompt.MaxActivationDistance or 10 end)
    end
    if not maxAct or maxAct < 2 then maxAct = 10 end

    local pumpkinRadius = math.max(pumpkinSize.X, pumpkinSize.Z) / 2

    if pumpkinRadius + 1 < maxAct * 0.9 then
        -- Stand outside pumpkin, within activation range
        local preferred = pumpkinRadius + CONFIG.standDistBuffer
        local maxAllowed = maxAct * 0.85
        return math.max(CONFIG.standDistMin, math.min(preferred, maxAllowed))
    else
        -- Pumpkin is nearly as big as the prompt's range → prioritize range
        return math.max(1.5, maxAct * 0.7)
    end
end

local function computeStandPosition(pumpkinPos, pumpkinSize, prompt, character, directionIndex)
    local dist = computeStandDistance(prompt, pumpkinSize)
    local dir = STAND_DIRECTIONS[((directionIndex - 1) % #STAND_DIRECTIONS) + 1]
    local targetXZ = pumpkinPos + Vector3.new(dir.X, 0, dir.Z) * dist

    local ground = findGroundBelow(targetXZ, character)
    if ground then
        return Vector3.new(ground.X, ground.Y + CONFIG.groundOffset, ground.Z)
    end
    return Vector3.new(targetXZ.X, pumpkinPos.Y + CONFIG.groundOffset, targetXZ.Z)
end

local function teleportBeside(inst, pumpkinPos, pumpkinSize, prompt)
    local char, _, hrp = getLocalCharacter()
    if not hrp then return false end

    local idx = (attemptOffsets[inst] or 0) + 1
    attemptOffsets[inst] = idx

    local standPos = computeStandPosition(pumpkinPos, pumpkinSize, prompt, char, idx)
    local lookAt = Vector3.new(pumpkinPos.X, standPos.Y, pumpkinPos.Z)

    local ok = pcall(function()
        hrp.CFrame = CFrame.lookAt(standPos, lookAt)
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    return ok
end

local function promptDistance(prompt)
    if not prompt or not prompt.Parent then return nil end
    local _, _, hrp = getLocalCharacter()
    if not hrp then return nil end
    local parent = prompt.Parent
    local ppos
    if parent:IsA("BasePart") then ppos = parent.Position
    elseif parent:IsA("Model") then ppos = getPosition(parent)
    elseif parent:IsA("Attachment") then ppos = parent.WorldPosition end
    if not ppos then return nil end
    return (ppos - hrp.Position).Magnitude
end

-- ============================================================
-- FIRE (natural, no property boost)
-- ============================================================
local function firePrompt(prompt)
    if not prompt or not prompt.Parent then return false end
    if HAS_FIRE_PROMPT then
        for i = 1, 3 do
            local ok = pcall(fireproximityprompt, prompt)
            if ok then return true end
            w(0.04)
        end
    end
    pcall(function()
        prompt:InputHoldBegin()
        w(math.max(0.05, tonumber(prompt.HoldDuration) or 0.1))
        prompt:InputHoldEnd()
    end)
    return true
end

local function fireClick(cd)
    if not cd or not cd.Parent then return false end
    if HAS_FIRE_CLICK then
        for i = 1, 3 do
            local ok = pcall(fireclickdetector, cd)
            if ok then return true end
            w(0.04)
        end
    end
    return false
end

-- ============================================================
-- COLLECT ONE
-- ============================================================
local function collectOne(rec)
    local inst = rec.instance
    if not inst or not inst.Parent then return false, "gone", false end

    local pumpkinPos, pumpkinSize = getPumpkinBounds(inst)
    if not pumpkinPos then return false, "no position", true end
    if not pumpkinSize then pumpkinSize = Vector3.new(2, 2, 2) end

    local prompt = findActivePrompt(inst)
    local cd = findClickDetector(inst)
    if not prompt and not cd then
        return true, "already gone", false
    end

    -- Teleport beside pumpkin
    if not teleportBeside(inst, pumpkinPos, pumpkinSize, prompt) then
        return false, "no character", true
    end
    w(CONFIG.settleTime)

    -- Re-check after landing
    prompt = findActivePrompt(inst)
    cd = findClickDetector(inst)
    if not prompt and not cd then
        return true, "collected on arrive", false
    end

    -- Distance sanity check
    if prompt then
        local d = promptDistance(prompt)
        local maxAct = 10
        pcall(function() maxAct = prompt.MaxActivationDistance or 10 end)
        if d and d > maxAct then
            return false, string.format("too far (%.1f > %.1f)", d, maxAct), true
        end
    end

    -- Fire
    local fired = false
    if prompt then fired = firePrompt(prompt) or fired end
    if cd and not fired then fired = fireClick(cd) or fired end
    if not fired then return false, "fire failed", true end
    w(CONFIG.postFireWait)

    -- Verify
    local p2 = findActivePrompt(inst)
    local c2 = findClickDetector(inst)
    if not p2 and not c2 then return true, "collected", false end

    -- Follow-up fire
    if p2 then firePrompt(p2) end
    if c2 and not p2 then fireClick(c2) end
    w(CONFIG.postFireWait)
    p2 = findActivePrompt(inst)
    c2 = findClickDetector(inst)
    if not p2 and not c2 then return true, "collected (follow-up)", false end

    return false, "still active", true
end

-- ============================================================
-- AUTO COLLECT LOOP
-- ============================================================
local function getSortedActiveList()
    local char = Me.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = root and root.Position
    local list = {}
    for _, rec in ipairs(foundOrder) do
        local inst = rec.instance
        if inst and inst.Parent and rec.isActive and not blacklist[inst] then
            local pos = getPosition(inst) or rec.position
            if pos then
                local d = myPos and (pos - myPos).Magnitude or 0
                table.insert(list, {rec = rec, dist = d, pos = pos})
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

local function autoCollectLoop()
    if collectBusy then return end
    collectBusy = true
    while automating and running do
        local char = getLocalCharacter()
        if not char then
            w(1)
        else
            local list = getSortedActiveList()
            if #list == 0 then
                w(1.5)
            else
                for _, entry in ipairs(list) do
                    if not automating or not running then break end
                    local rec = entry.rec
                    local inst = rec.instance
                    if inst and inst.Parent and rec.isActive then
                        local ok, reason, stillActive = collectOne(rec)
                        if ok then
                            collectedCount += 1
                            rec.isActive = false
                            print(string.format("[PumpkinAuto] ✓ %s (%s) · total: %d",
                                rec.path, reason, collectedCount))
                        else
                            failedAttempts[inst] = (failedAttempts[inst] or 0) + 1
                            if failedAttempts[inst] >= CONFIG.maxRetries + 1 then
                                blacklist[inst] = true
                                print(string.format("[PumpkinAuto] ✗ Gave up after %d tries: %s (%s)",
                                    failedAttempts[inst], rec.path, reason))
                            else
                                print(string.format("[PumpkinAuto] ✗ Retry %d/%d: %s (%s)",
                                    failedAttempts[inst], CONFIG.maxRetries + 1,
                                    rec.path, reason))
                            end
                            if not stillActive then rec.isActive = false end
                        end
                        w(CONFIG.delayBetween)
                    end
                end
            end
        end
        w(0.3)
    end
    collectBusy = false
end

-- ============================================================
-- TOGGLE SWITCH
-- ============================================================
local function createToggleSwitch(parent, size, initialState, onChanged)
    local track = Instance.new("Frame")
    track.Size = size
    track.BackgroundColor3 = initialState
        and Color3.fromRGB(60, 170, 90)
        or  Color3.fromRGB(55, 62, 72)
    track.BorderSizePixel = 0
    track.Parent = parent
    local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(1, 0); tc.Parent = track

    local knobSize = size.Y.Offset - 6
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(knobSize, knobSize)
    knob.Position = initialState
        and UDim2.new(1, -(knobSize + 3), 0.5, -(knobSize / 2))
        or  UDim2.new(0, 3, 0.5, -(knobSize / 2))
    knob.BackgroundColor3 = Color3.fromRGB(245, 250, 255)
    knob.BorderSizePixel = 0
    knob.Parent = track
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob
    local ks = Instance.new("UIStroke")
    ks.Color = Color3.fromRGB(0, 0, 0); ks.Transparency = 0.85; ks.Thickness = 1
    ks.Parent = knob

    local click = Instance.new("TextButton")
    click.Text = ""
    click.Size = UDim2.fromScale(1, 1)
    click.BackgroundTransparency = 1
    click.AutoButtonColor = false
    click.Parent = track

    local state = initialState
    local animating = false

    local function setState(newState, animate)
        if animating or state == newState then return end
        state = newState
        local targetPos = state
            and UDim2.new(1, -(knobSize + 3), 0.5, -(knobSize / 2))
            or  UDim2.new(0, 3, 0.5, -(knobSize / 2))
        local targetColor = state
            and Color3.fromRGB(60, 170, 90)
            or  Color3.fromRGB(55, 62, 72)
        if animate then
            animating = true
            local ti = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TweenService:Create(knob,  ti, {Position = targetPos}):Play()
            TweenService:Create(track, ti, {BackgroundColor3 = targetColor}):Play()
            task.delay(0.17, function() animating = false end)
        else
            knob.Position = targetPos
            track.BackgroundColor3 = targetColor
        end
        if onChanged then pcall(onChanged, state) end
    end

    click.MouseButton1Click:Connect(function() setState(not state, true) end)

    return {
        track = track,
        setState = setState,
        getState = function() return state end,
    }
end

