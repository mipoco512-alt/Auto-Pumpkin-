    promptPatterns  = { "collect", "grab", "pick", "harvest", "take", "pumpkin" },

    -- Stand distance from pumpkin CENTER, in studs
    standDistMin    = 3,        -- never closer than this
    standDistFactor = 0.6,      -- percent of prompt MaxActivationDistance
    standDistBuffer = 3,        -- extra studs beyond pumpkin radius
    groundOffset    = 3,        -- HRP sits this far above ground

    settleTime      = 0.30,
    postFireWait    = 0.60,
    delayBetween    = 0.7,
    maxRetries      = 2,
    scanInterval    = 3,
    batchSize       = 500,
